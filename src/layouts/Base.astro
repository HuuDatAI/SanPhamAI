---
import { getSettings, safeUrl } from '../lib/store';
import ZaloButton from '../components/ZaloButton.astro';
interface Props { title: string; description?: string; noindex?: boolean; hero?: boolean }
const { title, description = 'Dự án AI & chuyển đổi số, chương trình đào tạo AI ứng dụng.', noindex = false, hero = false } = Astro.props;
const s = getSettings();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const fullTitle = title === s.brand ? s.brand : `${title} · ${s.brand}`;
const hasQr = !!s.zaloQr;
const drive = safeUrl(s.zaloQrDrive);
const nav = [
  { href: `${base}/projects/`, label: 'Dự án', on: path.startsWith(`${base}/projects`) },
  { href: `${base}/chuyen-mon/`, label: 'Chuyên môn', on: path.startsWith(`${base}/chuyen-mon`) },
  { href: `${base}/gioi-thieu/`, label: 'Giới thiệu', on: path.startsWith(`${base}/gioi-thieu`) },
];
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="vi_VN" />
  {noindex && <meta name="robots" content="noindex" />}
  <script is:inline>
    // Chỉ ẩn nội dung chờ hiệu ứng khi JS chạy được; nếu script chuyển động không khởi động trong 4 giây thì hiện lại hết.
    document.documentElement.classList.add('js');
    setTimeout(function () { if (!window.__motionReady) document.documentElement.classList.remove('js'); }, 4000);
  </script>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Bỏ qua điều hướng</a>
  <header class:list={['top', hero && 'over-hero']} id="top">
    <div class="wrap bar">
      <a class="brand" href={`${base}/`} aria-label={`${s.brand} — trang chủ`}>{s.brand}</a>
      <nav aria-label="Điều hướng chính">
        {nav.map((n) => <a href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <ZaloButton label="Liên hệ" variant="accent" source="header" />
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot on-dark">
    <div class="wrap foot-in">
      <div>
        <strong class="brand">{s.brand}</strong>
        <p class="muted">{s.personName} · {s.positioning}{s.phone && <> · Điện thoại/Zalo: <a href={`tel:${s.phone}`}>{s.phoneDisplay}</a></>}</p>
      </div>
      <div class="foot-cta">
        <ZaloButton label="Trao đổi qua Zalo" variant="light" source="footer" />
      </div>
    </div>
  </footer>
  {hasQr && (
    <dialog id="qrDlg" class="qr-dlg" aria-label="Mã QR Zalo">
      <figure>
        <img src={s.zaloQr} alt={s.zaloQrAlt} width="840" height="840" />
        <figcaption>{s.zaloQrCaption}</figcaption>
      </figure>
      <div class="qr-act">
        {drive && <a class="btn line" href={drive} target="_blank" rel="noopener noreferrer">Mở ảnh QR</a>}
        <button type="button" class="btn accent" id="qrClose">Đóng</button>
      </div>
    </dialog>
  )}
  <script>
    const qrDlg = document.getElementById('qrDlg') as HTMLDialogElement | null;
    document.querySelectorAll('[data-qr-open]').forEach((b) => b.addEventListener('click', () => qrDlg?.showModal()));
    document.getElementById('qrClose')?.addEventListener('click', () => qrDlg?.close());
    qrDlg?.addEventListener('click', (e) => { if (e.target === qrDlg) qrDlg.close(); });
  </script>
  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 861px)');

    // 1) Header: trong suốt trên hero, đổi nền khi cuộn.
    const top = document.getElementById('top');
    const setScrolled = () => top?.classList.toggle('scrolled', window.scrollY > 24);
    window.addEventListener('scroll', setScrolled, { passive: true });
    setScrolled();

    // 2) Reveal khi cuộn tới (một lần).
    const items = [...document.querySelectorAll<HTMLElement>('.reveal')];
    if (reduce.matches || !('IntersectionObserver' in window)) {
      items.forEach((e) => e.classList.add('in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        for (const en of entries) if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.08 });
      items.forEach((e) => io.observe(e));
    }

    // 3) Parallax nhiều lớp: mỗi phần tử [data-depth] lệch theo tiến trình cuộn của khung cha [data-scene]
    //    với hệ số riêng (nhanh/chậm khác nhau). Giới hạn ±28px, chỉ desktop, tắt khi giảm chuyển động.
    const layers = [...document.querySelectorAll<HTMLElement>('[data-depth]')];
    const MAX = 28;
    let ticking = false;
    function update() {
      ticking = false;
      if (reduce.matches || !desktop.matches) { layers.forEach((l) => (l.style.transform = '')); return; }
      const vh = window.innerHeight;
      for (const l of layers) {
        const scene = l.closest<HTMLElement>('[data-scene]');
        if (!scene) continue;
        const box = scene.getBoundingClientRect();
        if (box.bottom < 0 || box.top > vh) continue;
        const progress = (box.top + box.height / 2 - vh / 2) / vh;      // -1..1 quanh giữa màn hình
        const depth = Number(l.dataset.depth);                              // âm = chậm hơn nền, dương = nhanh hơn
        const y = Math.max(-MAX, Math.min(MAX, -progress * 56 * depth));
        l.style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0)';
      }
    }
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener('resize', update);
    reduce.addEventListener('change', update);
    if (layers.length) update();

    (window as unknown as { __motionReady: boolean }).__motionReady = true;
  </script>
</body>
</html>

<style is:global>
  :root {
    /* Bản Hữu Đạt: phong cách doanh nghiệp cao cấp — ngà, navy đậm, vàng ánh kim, tiêu đề serif. */
    --bg: #f7f5f0; --paper: #ffffff; --ink: #0f1b2d; --muted: #5a6272; --line: #e4ded2; --soft: #f1ece2;
    --navy: #0d1b2e; --navy-2: #13253d; --navy-line: #2a3b55; --on-dark: #f3efe6; --on-dark-muted: #bdb6a6;
    --accent: #b8924a; --accent-ink: #0d1b2e; --gold-2: #d4b06a;
    --radius: 6px;
    --font: 'Be Vietnam Pro', system-ui, 'Segoe UI', sans-serif;
    --display: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
  }
  * { box-sizing: border-box; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 15px/1.6 var(--font); -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  img, svg { max-width: 100%; display: block; }
  h1, h2, h3 { line-height: 1.2; letter-spacing: -0.015em; margin: 0 0 .5em; font-weight: 600; }
  h1 { font-size: clamp(28px, 3.6vw, 40px); }
  h2 { font-size: clamp(20px, 2.4vw, 27px); }
  h3 { font-size: 16px; }
  p { margin: 0 0 1em; }
  .muted { color: var(--muted); }
  .wrap { width: min(1120px, 100% - 32px); margin-inline: auto; }
  .skip { position: absolute; left: -999px; top: 0; background: var(--ink); color: #fff; padding: 8px 12px; z-index: 50; }
  .skip:focus { left: 8px; top: 8px; }
  /* Vòng focus hai lớp: nhìn rõ trên cả nền sáng lẫn nền tối, cùng màu nhấn với nút và trạng thái chọn. */
  :focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; box-shadow: 0 0 0 5px rgba(184,146,74,.6); border-radius: 6px; }
  .on-dark :focus-visible, .dark :focus-visible, .top.scrolled :focus-visible { outline-color: #fff; }

  .mode-bar { margin: 0; padding: 5px 16px; text-align: center; font-size: 12.5px; color: var(--muted); background: var(--soft); border-bottom: 1px solid var(--line); }

  /* Header */
  .top { position: sticky; top: 0; z-index: 20; background: rgba(245,247,250,.92); backdrop-filter: saturate(1.2) blur(8px); border-bottom: 1px solid var(--line); transition: background .25s ease, border-color .25s ease, color .25s ease; }
  .top.over-hero { background: transparent; backdrop-filter: none; border-bottom-color: transparent; margin-bottom: -56px; }
  .top.scrolled { background: rgba(11,20,36,.94); border-bottom-color: var(--navy-line); color: var(--on-dark); }
  .bar { display: flex; align-items: center; gap: 20px; min-height: 56px; }
  .brand { font-weight: 600; letter-spacing: .16em; text-decoration: none; font-size: 15px; }
  .bar nav { display: flex; gap: 6px; margin-left: auto; font-size: 14px; }
  .bar nav a { text-decoration: none; padding: 8px 10px; border-bottom: 2px solid transparent; color: inherit; opacity: .78; transition: opacity .18s ease, border-color .18s ease; }
  .bar nav a:hover { opacity: 1; }
  .bar nav a[aria-current="page"] { opacity: 1; border-bottom-color: var(--accent); }

  /* Nút: một màu nhấn (cam) cho hành động chính; chữ mực đậm trên nền cam để đủ tương phản. */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 40px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--ink); background: var(--ink); color: #fff; font: 500 14px var(--font); text-decoration: none; cursor: pointer; transition: background .18s ease, color .18s ease, border-color .18s ease; }
  .btn:hover { background: #26324a; }
  .btn.accent { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
  .btn.accent:hover { background: #ff8450; border-color: #ff8450; }
  .btn.line { background: transparent; color: var(--ink); }
  .btn.line:hover { background: var(--soft); }
  .btn.light { background: transparent; color: var(--on-dark); border-color: #5a6a8a; }
  .btn.light:hover { background: rgba(255,255,255,.08); border-color: var(--on-dark); }
  .btn.is-off { border-style: dashed; background: transparent; color: var(--muted); border-color: #9aa5ba; cursor: default; }
  .btn.is-off:hover { background: transparent; }
  .qr-dlg { border: 0; border-radius: 16px; padding: 16px; width: min(440px, 94vw); background: var(--paper); color: var(--ink); max-height: 96vh; }
  .qr-dlg::backdrop { background: rgba(11,20,36,.72); }
  .qr-dlg figure { margin: 0; }
  .qr-dlg img { display: block; margin: 0 auto; width: auto; max-width: 100%; max-height: 68vh; height: auto; border-radius: 12px; }
  .qr-dlg figcaption { text-align: center; font-size: 14px; color: var(--muted); margin: 10px 0 0; }
  .qr-act { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
  .on-dark .btn.is-off, .dark .btn.is-off { color: var(--on-dark-muted); border-color: #5a6a8a; }

  .section { padding: clamp(28px, 4.5vw, 52px) 0; }
  .dark { background: var(--navy); color: var(--on-dark); }
  .dark .muted, .on-dark .muted { color: var(--on-dark-muted); }
  .eyebrow { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .dark .eyebrow { color: var(--on-dark-muted); }
  .head-row { display: flex; justify-content: space-between; align-items: end; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
  .head-row h2 { margin: 0; }
  .link-arrow { text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; font-size: 15px; }
  .link-arrow::after { content: ' →'; }

  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; text-decoration: none; background: var(--paper); transition: border-color .18s ease, box-shadow .18s ease; }
  .card:hover { border-color: var(--ink); box-shadow: 0 8px 24px rgba(11,20,36,.08); }
  .card .body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .card h3 { margin: 0; }
  .card p { color: var(--muted); font-size: 14px; margin: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 10px; }
  .tag { font-size: 12.5px; padding: 2px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); background: var(--paper); }
  .dark .tag { background: transparent; border-color: var(--navy-line); color: var(--on-dark-muted); }
  .pv-tag { position: absolute; right: 10px; top: 10px; font-size: 11.5px; font-weight: 600; padding: 2px 9px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); z-index: 2; }
  .badge-dev { font-size: 12px; font-weight: 600; padding: 2px 10px; border-radius: 999px; border: 1px solid var(--ink); color: var(--ink); background: transparent; align-self: flex-start; }
  .dark .badge-dev { border-color: var(--on-dark-muted); color: var(--on-dark); }
  .badge-sample { font-size: 12px; font-weight: 600; padding: 2px 10px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); align-self: flex-start; }
  .art { background: var(--soft); aspect-ratio: 16 / 7; display: grid; place-items: center; border-bottom: 1px solid var(--line); }
  .art svg { width: 44%; height: auto; stroke: var(--ink); fill: none; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .art-note { font-size: 12px; color: var(--muted); padding: 6px 12px; border-top: 1px solid var(--line); background: var(--paper); }

  .foot { background: var(--navy); color: var(--on-dark); padding: 28px 0; margin-top: 0; }
  .foot-in { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .foot p { margin: 4px 0 0; font-size: 14px; }

  .empty, .state { border: 1px dashed #9aa5ba; border-radius: var(--radius); padding: 32px; text-align: center; color: var(--muted); }
  .crumbs { font-size: 14px; color: var(--muted); padding: 22px 0 6px; }
  .crumbs a { text-decoration: none; border-bottom: 1px solid var(--line); }

  /* Hợp đồng chuyển động: hover/focus 160–220ms; reveal = opacity + translateY 16px, 500ms, stagger 70ms.
     Mặc định MỌI nội dung hiển thị; chỉ khi có class .js (script chạy được) và người dùng không chọn giảm chuyển động mới ẩn chờ reveal. */
  @media (prefers-reduced-motion: no-preference) {
    .js .reveal { opacity: 0; transform: translateY(16px); }
    .js .reveal.in { opacity: 1; transform: none; transition: opacity .5s ease, transform .5s ease; transition-delay: calc(var(--d, 0) * 70ms); }
    .link-arrow::after { display: inline-block; transition: transform .18s ease; }
    .link-arrow:hover::after { transform: translateX(3px); }
  }
  @media (max-width: 640px) {
    .bar { gap: 8px; flex-wrap: wrap; padding: 8px 0; }
    .bar nav { order: 3; width: 100%; margin-left: -10px; }
    .bar .btn { margin-left: auto; }
    .top.over-hero { margin-bottom: -96px; }
  }

  /* ===== Phong cách doanh nghiệp cao cấp (bản Hữu Đạt) ===== */
  h1, h2, .brand, .pn, .pos { font-family: var(--serif); }
  h1, h2 { font-weight: 600; letter-spacing: -0.005em; }
  h1 { line-height: 1.12; }
  h3 { font-weight: 600; letter-spacing: 0; }
  .brand { letter-spacing: .22em; font-weight: 700; }
  .eyebrow { letter-spacing: .22em; font-weight: 500; color: var(--accent) !important; font-size: 11.5px; }
  .eyebrow::before { content: ''; display: inline-block; width: 28px; height: 1px; background: currentColor; vertical-align: middle; margin-right: 10px; }
  /* Nút: vuông vức, chữ in hoa giãn cách — cảm giác tư vấn doanh nghiệp */
  .btn { border-radius: 2px; text-transform: uppercase; letter-spacing: .12em; font-size: 12.5px; font-weight: 600; min-height: 44px; padding: 0 22px; }
  .btn.accent { background: var(--navy); border-color: var(--navy); color: #f3efe6; }
  .btn.accent:hover { background: #1b2f4d; border-color: #1b2f4d; }
  .dark .btn.accent, .on-dark .btn.accent, .top.scrolled .btn.accent { background: var(--accent); border-color: var(--accent); color: var(--navy); }
  .dark .btn.accent:hover, .on-dark .btn.accent:hover, .top.scrolled .btn.accent:hover { background: var(--gold-2); border-color: var(--gold-2); }
  .btn.line { border-color: var(--ink); }
  .btn.light { border-color: rgba(212,176,106,.55); color: var(--on-dark); }
  .btn.light:hover { border-color: var(--gold-2); background: rgba(212,176,106,.08); }
  .bar nav a[aria-current="page"] { border-bottom-color: var(--accent); }
  .top { background: rgba(247,245,240,.95); border-bottom-color: var(--line); }
  .top.over-hero { background: transparent; border-bottom-color: transparent; }
  .top.scrolled { background: rgba(13,27,46,.96); border-bottom-color: var(--navy-line); }
  .foot-in { align-items: center; }
  .dark { background: linear-gradient(180deg, #0d1b2e 0%, #0b1726 100%); }
  .dark h2, .dark h3 { color: #f6f1e7; }
  .link-arrow { text-decoration-color: var(--accent); }
  /* Bỏ các chi tiết trang trí trẻ trung: chữ nền khổng lồ, thẻ minh họa bay */
  .ghost, .float { display: none !important; }
  [class*="card"], .side-box, .photo, figure.photo { border-radius: var(--radius) !important; }
  .photo { box-shadow: 0 24px 50px rgba(13,27,46,.16) !important; border: 1px solid rgba(184,146,74,.35) !important; }
  .foot { border-top: 2px solid var(--accent); }
</style>
