---
import { getSettings, mode } from '../lib/store';
import ZaloButton from '../components/ZaloButton.astro';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = 'Dự án AI & chuyển đổi số, chương trình đào tạo AI ứng dụng.', noindex = false } = Astro.props;
const s = getSettings();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === s.brand ? s.brand : `${title} · ${s.brand}`;
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="vi_VN" />
  {noindex && <meta name="robots" content="noindex" />}
  <script is:inline>
    // Chỉ ẩn nội dung chờ hiệu ứng khi JS chạy được; nếu script chuyển động không khởi động trong 4 giây thì hiện lại hết.
    document.documentElement.classList.add('js');
    setTimeout(function () { if (!window.__motionReady) document.documentElement.classList.remove('js'); }, 4000);
  </script>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Bỏ qua điều hướng</a>
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href={`${base}/`} aria-label={`${s.brand} — trang chủ`}>{s.brand}</a>
      <nav aria-label="Điều hướng chính">
        <a href={`${base}/projects/`}>Dự án</a>
        <a href={`${base}/khoa-hoc/`}>Khóa học</a>
        <a href={`${base}/#gioi-thieu`}>Giới thiệu</a>
      </nav>
      <ZaloButton label="Liên hệ Zalo" variant="solid" source="header" />
    </div>
  </header>
  {mode === 'mau' && (
    <p class="mode-bar" role="note">Bản xem trước · dữ liệu mẫu, một số mục là minh họa và sẽ được thay bằng nội dung thật.</p>
  )}
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap foot-in">
      <div>
        <strong class="brand">{s.brand}</strong>
        <p class="muted">{s.personName} · {s.positioning}</p>
      </div>
      <ZaloButton label="Trao đổi qua Zalo" variant="line" source="footer" />
    </div>
  </footer>
  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 861px)');

    // 1) Reveal khi cuộn tới (một lần).
    const items = [...document.querySelectorAll<HTMLElement>('.reveal')];
    if (reduce.matches || !('IntersectionObserver' in window)) {
      items.forEach((e) => e.classList.add('in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        for (const en of entries) if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.08 });
      items.forEach((e) => io.observe(e));
    }

    // 2) Parallax nhẹ (tối đa 24px, chỉ desktop, tắt khi giảm chuyển động).
    const par = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
    let ticking = false;
    function update() {
      ticking = false;
      if (reduce.matches || !desktop.matches) { par.forEach((p) => (p.style.transform = '')); return; }
      const vh = window.innerHeight;
      for (const p of par) {
        const box = (p.parentElement as HTMLElement).getBoundingClientRect();
        if (box.bottom < 0 || box.top > vh) continue;
        const progress = (box.top + box.height / 2 - vh / 2) / vh;
        const y = Math.max(-24, Math.min(24, -progress * 40));
        p.style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0) scale(1.08)';
      }
    }
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener('resize', update);
    reduce.addEventListener('change', update);
    if (par.length) update();

    (window as unknown as { __motionReady: boolean }).__motionReady = true;
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --ink: #111111; --muted: #5b5b5b; --line: #e4e4e4; --soft: #f6f6f6;
    --accent: #0a4fd6; --focus: #0a4fd6; --radius: 10px;
    --font: 'Be Vietnam Pro', system-ui, 'Segoe UI', sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 15px/1.6 var(--font); -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  img, svg { max-width: 100%; display: block; }
  h1, h2, h3 { line-height: 1.2; letter-spacing: -0.015em; margin: 0 0 .5em; font-weight: 600; }
  h1 { font-size: clamp(26px, 3.4vw, 38px); }
  h2 { font-size: clamp(19px, 2.3vw, 25px); }
  h3 { font-size: 16px; }
  p { margin: 0 0 1em; }
  .muted { color: var(--muted); }
  .wrap { width: min(1120px, 100% - 32px); margin-inline: auto; }
  .skip { position: absolute; left: -999px; top: 0; background: var(--ink); color: #fff; padding: 8px 12px; z-index: 50; }
  .skip:focus { left: 8px; top: 8px; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 4px; }

  .top { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,.94); backdrop-filter: saturate(1.2) blur(6px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 20px; min-height: 52px; }
  .brand { font-weight: 600; letter-spacing: .14em; text-decoration: none; font-size: 15px; }
  .bar nav { display: flex; gap: 18px; margin-left: auto; font-size: 14px; }
  .bar nav a { text-decoration: none; color: var(--muted); padding: 10px 2px; }
  .bar nav a:hover { color: var(--ink); }
  .mode-bar { margin: 0; padding: 6px 16px; text-align: center; font-size: 13px; color: var(--muted); background: var(--soft); border-bottom: 1px solid var(--line); }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 40px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--ink); background: var(--ink); color: #fff; font: 500 14px var(--font); text-decoration: none; cursor: pointer; transition: background .15s, color .15s, border-color .15s; }
  .btn:hover { background: #333; }
  .btn.line { background: transparent; color: var(--ink); }
  .btn.line:hover { background: var(--soft); }
  .btn.is-off { border-style: dashed; background: transparent; color: var(--muted); border-color: #aaa; cursor: default; }
  .btn.is-off:hover { background: transparent; }

  .section { padding: clamp(26px, 4vw, 44px) 0; }
  .section + .section { border-top: 1px solid var(--line); }
  .eyebrow { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .head-row { display: flex; justify-content: space-between; align-items: end; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .head-row h2 { margin: 0; }
  .link-arrow { text-decoration: none; border-bottom: 1px solid var(--ink); padding-bottom: 2px; font-size: 15px; }

  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; text-decoration: none; background: #fff; transition: border-color .15s, transform .2s ease; }
  .card:hover { border-color: var(--ink); }
  .card .body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .card h3 { margin: 0; }
  .card p { color: var(--muted); font-size: 14px; margin: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 10px; }
  .tag { font-size: 12.5px; padding: 2px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }
  .badge-sample { font-size: 12px; font-weight: 500; padding: 2px 10px; border-radius: 999px; background: var(--ink); color: #fff; align-self: flex-start; }
  .art { background: var(--soft); aspect-ratio: 16 / 7; display: grid; place-items: center; border-bottom: 1px solid var(--line); }
  .art svg { width: 44%; height: auto; stroke: var(--ink); fill: none; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .art-note { font-size: 12px; color: var(--muted); padding: 6px 12px; border-top: 1px solid var(--line); background: #fff; }

  .foot { border-top: 1px solid var(--line); padding: 24px 0; margin-top: 16px; }
  .foot-in { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .foot p { margin: 4px 0 0; font-size: 14px; }

  .empty, .state { border: 1px dashed #bbb; border-radius: var(--radius); padding: 32px; text-align: center; color: var(--muted); }
  .crumbs { font-size: 14px; color: var(--muted); padding: 22px 0 6px; }
  .crumbs a { text-decoration: none; border-bottom: 1px solid var(--line); }

  /* Hợp đồng chuyển động: hover/focus 160–220ms; reveal = opacity + translateY 16px, 500ms, stagger 70ms; ảnh scale tối đa ~1.02.
     Mặc định MỌI nội dung hiển thị; chỉ khi có class .js (script chạy được) và người dùng không chọn giảm chuyển động mới ẩn chờ reveal. */
  @media (prefers-reduced-motion: no-preference) {
    .js .reveal { opacity: 0; transform: translateY(16px); }
    .js .reveal.in { opacity: 1; transform: none; transition: opacity .5s ease, transform .5s ease; transition-delay: calc(var(--d, 0) * 70ms); }
    .art svg { transition: transform .2s ease; }
    .card:hover .art svg, .show-list a:hover ~ * .art svg { transform: scale(1.02); }
    .link-arrow::after { display: inline-block; transition: transform .18s ease; }
    .link-arrow:hover::after, .card:hover .go::after { transform: translateX(3px); }
  }
  .link-arrow::after { content: ' →'; }
  @media (max-width: 640px) {
    .bar { gap: 10px; flex-wrap: wrap; padding: 8px 0; }
    .bar nav { order: 3; width: 100%; margin-left: 0; gap: 18px; }
    .bar .btn { margin-left: auto; min-height: 40px; padding: 0 16px; }
  }
</style>
