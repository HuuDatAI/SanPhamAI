---
/** Bộ icon nét mảnh thống nhất (24×24, nét 1.5). Luôn đi kèm nhãn chữ; không mang ý nghĩa một mình. */
interface Props { name: 'flow' | 'prompt' | 'calc' | 'doc' | 'compass' | 'layers' | 'book' | 'search'; size?: number }
const { name, size = 22 } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'flow' && <g><rect x="3" y="4" width="6" height="5" rx="1.5" /><rect x="15" y="4" width="6" height="5" rx="1.5" /><rect x="9" y="15" width="6" height="5" rx="1.5" /><path d="M9 6.5h6M6 9v3h12V9M12 12v3" /></g>}
  {name === 'prompt' && <g><path d="M4 5h16v10H9l-4 4v-4H4z" /><path d="M8 9h8M8 12h5" /></g>}
  {name === 'calc' && <g><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M8 7h8M8 11h2M12 11h2M8 15h2M12 15h2M8 18h8" /></g>}
  {name === 'doc' && <g><path d="M7 3h7l4 4v14H7z" /><path d="M14 3v4h4M10 12h5M10 16h5" /></g>}
  {name === 'compass' && <g><circle cx="12" cy="12" r="9" /><path d="M15.5 8.5l-2 5-5 2 2-5z" /></g>}
  {name === 'layers' && <g><path d="M12 3l9 5-9 5-9-5z" /><path d="M3 13l9 5 9-5" /></g>}
  {name === 'book' && <g><path d="M4 5a2 2 0 0 1 2-2h13v15H6a2 2 0 0 0-2 2z" /><path d="M4 20V5M9 8h6" /></g>}
  {name === 'search' && <g><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" /></g>}
</svg>
<style is:global>.icon { flex: none; }</style>
