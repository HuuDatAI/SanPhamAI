---
/** Ảnh minh họa nét mảnh theo nghiệp vụ. KHÔNG phải ảnh chụp hệ thống thật — luôn kèm chú thích. */
import type { Kind } from '../data/seed';
interface Props { kind: Kind; note?: boolean }
const { kind, note = true } = Astro.props;
---
<div class="art" role="img" aria-label="Hình minh họa, không phải ảnh chụp hệ thống thật">
  {kind === 'funnel' && (<svg viewBox="0 0 200 130"><path d="M20 20h160l-55 45v40l-50 12V65z"/><path d="M40 20v-8M100 20v-8M160 20v-8"/></svg>)}
  {kind === 'people' && (<svg viewBox="0 0 200 130"><circle cx="70" cy="42" r="16"/><path d="M38 100c0-20 14-32 32-32s32 12 32 32"/><circle cx="138" cy="48" r="12"/><path d="M118 100c2-14 11-22 22-22s20 8 22 22"/><path d="M168 24l8 8 14-16"/></svg>)}
  {kind === 'chat' && (<svg viewBox="0 0 200 130"><rect x="22" y="18" width="104" height="50" rx="10"/><path d="M50 68l-6 16 22-16"/><rect x="86" y="62" width="92" height="46" rx="10"/><path d="M104 80h56M104 92h36"/><path d="M42 36h64M42 48h40"/></svg>)}
  {kind === 'lms' && (<svg viewBox="0 0 200 130"><rect x="28" y="16" width="144" height="86" rx="8"/><path d="M28 36h144"/><path d="M48 58h50M48 74h72"/><rect x="48" y="88" width="104" height="6" rx="3"/><path d="M48 91h62" stroke-width="3"/><path d="M80 118h40"/></svg>)}
  {kind === 'building' && (<svg viewBox="0 0 200 130"><path d="M24 112h152"/><path d="M44 112V40h60v72"/><path d="M104 112V64h52v48"/><path d="M58 56h10M80 56h10M58 76h10M80 76h10M58 96h10M80 96h10M118 80h10M138 80h10M118 98h10M138 98h10"/><path d="M60 40V22l36 18"/></svg>)}
  {kind === 'sheet' && (<svg viewBox="0 0 200 130"><rect x="30" y="16" width="140" height="98" rx="6"/><path d="M30 42h140M30 68h140M30 92h140M80 16v98M126 16v98"/><path d="M40 106l22-12 20 6 24-18"/></svg>)}
  {kind === 'cards' && (<svg viewBox="0 0 200 130"><rect x="26" y="22" width="48" height="86" rx="6"/><rect x="82" y="22" width="48" height="60" rx="6"/><rect x="138" y="22" width="36" height="74" rx="6"/><path d="M34 40h32M34 54h20M90 40h32M90 54h18M146 40h20"/></svg>)}
  {kind === 'calendar' && (<svg viewBox="0 0 200 130"><rect x="30" y="22" width="140" height="92" rx="8"/><path d="M30 46h140M66 12v18M134 12v18"/><path d="M50 62h14M82 62h14M114 62h14M146 62h8M50 82h14M82 82h14M114 82h14"/></svg>)}
</div>
{note && <div class="art-note">Hình minh họa</div>}
