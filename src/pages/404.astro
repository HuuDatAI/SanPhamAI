---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Không tìm thấy trang" noindex>
  <div class="wrap" style="padding:64px 0">
    <h1>Không tìm thấy trang</h1>
    <p class="muted">Đường dẫn này không tồn tại hoặc nội dung không còn công khai.</p>
    <p><a class="btn" href={`${base}/projects/`}>Xem danh sách dự án</a></p>
  </div>
</Base>
