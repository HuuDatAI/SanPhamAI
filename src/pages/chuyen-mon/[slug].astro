---
import Base from '../../layouts/Base.astro';
import Scene from '../../components/Scene.astro';
import Icon from '../../components/Icon.astro';
import ZaloButton from '../../components/ZaloButton.astro';
import CopyLink from '../../components/CopyLink.astro';
import { getCourses, getCourse, priceLabel } from '../../lib/store';

export function getStaticPaths() {
  return getCourses().map((c) => ({ params: { slug: c.slug } }));
}
const c = getCourse(Astro.params.slug!)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const icons = { 'ai-automation': 'flow', 'ai-co-ban': 'prompt', 'ai-cho-ke-toan': 'calc', 'ai-cho-dan-van-phong': 'doc' } as const;
---
<Base title={c.title} description={c.summary}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Điều hướng phụ"><a href={`${base}/chuyen-mon/`}>← Quay lại Chuyên môn</a></nav>
    <div class="detail">
      <aside class="side" aria-label="Hình minh họa">
        <div class="side-box"><Scene kind={c.art} depths={[0, 0, 0]} /><span class="stage-note">Hình minh họa · không phải ảnh hệ thống thật</span></div>
      </aside>
      <article class="story">
        <header class="reveal">
          <span class="ico"><Icon name={icons[c.slug as keyof typeof icons] ?? 'doc'} size={26} /></span>
          <h1>{c.title}</h1>
          <p class="lead">{c.summary}</p>
        </header>
        <dl class="facts reveal">
          <div><dt>Học phí</dt><dd>{priceLabel(c)}</dd></div>
          <div><dt>Lịch học</dt><dd>{c.scheduleText}</dd></div>
          {c.format && <div><dt>Hình thức</dt><dd>{c.format}</dd></div>}
        </dl>
        {c.audience.length > 0 && <section class="reveal"><h2><span>01</span>Đối tượng phù hợp</h2><ul>{c.audience.map((a) => <li>{a}</li>)}</ul></section>}
        <section class="reveal"><h2><span>{c.audience.length > 0 ? '02' : '01'}</span>Nội dung</h2><ul>{c.syllabus.map((s) => <li>{s}</li>)}</ul></section>
        <p class="muted small reveal">Trang này giới thiệu lĩnh vực tôi đang giảng dạy, chưa phải thông báo tuyển sinh hay cam kết về lịch khai giảng, thời lượng hoặc kết quả đầu ra.</p>
        <aside class="ask reveal">
          <h2>Quan tâm chủ đề này?</h2>
          <div class="cta-row">
            <ZaloButton label="Tư vấn chương trình đào tạo" variant="accent" source="course" entity={c.id} />
            <CopyLink title={c.title} />
          </div>
        </aside>
      </article>
    </div>
  </div>
</Base>

<style>
  .detail { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(20px, 4vw, 56px); align-items: start; padding-bottom: 24px; }
  .side { position: sticky; top: 72px; }
  .side-box { position: relative; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: linear-gradient(160deg, #e9f0fb, #f5f7fa); }
  .stage-note { position: absolute; left: 14px; bottom: 10px; font-size: 12px; color: var(--muted); }
  .ico { display: inline-grid; place-items: center; width: 46px; height: 46px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); margin-bottom: 10px; }
  .lead { font-size: 16px; color: var(--muted); }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); margin: 6px 0 4px; border-top: 1px solid var(--line); }
  .facts div { padding: 12px 0; border-bottom: 1px solid var(--line); }
  dt { font-size: 13px; color: var(--muted); } dd { margin: 2px 0 0; font-weight: 500; }
  section { padding: 18px 0; border-bottom: 1px solid var(--line); }
  section h2 { font-size: 17px; display: flex; gap: 12px; align-items: baseline; }
  section h2 span { font-size: 12px; color: var(--muted); font-weight: 500; }
  .small { font-size: 13.5px; margin-top: 14px; }
  .ask { margin-top: 18px; padding: 20px; border: 1px solid var(--line); border-radius: 14px; background: var(--soft); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
  @media (max-width: 860px) { .detail { grid-template-columns: 1fr; } .side { position: static; } }
</style>
