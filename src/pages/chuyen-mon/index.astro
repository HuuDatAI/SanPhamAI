---
import Base from '../../layouts/Base.astro';
import Scene from '../../components/Scene.astro';
import Icon from '../../components/Icon.astro';
import ZaloButton from '../../components/ZaloButton.astro';
import { getCourses } from '../../lib/store';
import { courseGroups, otherClasses } from '../../data/courses';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topics = getCourses();
const icons = { 'ai-automation': 'flow', 'ai-agent': 'flow', 'smax-ai-chatbot': 'prompt', 'vba-excel': 'calc', 'ai-co-ban': 'prompt', 'claude-ai-cong-viec': 'prompt', 'ai-cho-ke-toan': 'calc', 'excel-power-query-power-bi': 'calc', 'ai-cho-dan-van-phong': 'doc', 'chatgpt-hanh-chinh-ke-hoach-tai-chinh': 'doc' } as const;
let k = 0;
const steps = [
  { icon: 'search', t: 'Hiểu công việc', d: 'Tôi cùng bạn xác định nhu cầu thực tế, làm rõ mục tiêu và phạm vi ứng dụng AI phù hợp với công việc của bạn.' },
  { icon: 'layers', t: 'Thực hành theo tình huống', d: 'Tôi hướng dẫn bạn áp dụng AI để xử lý các công việc quen thuộc, với tình huống gần với thực tế công việc.' },
  { icon: 'prompt', t: 'Trao đổi cách áp dụng', d: 'Chúng ta cùng thảo luận, điều chỉnh cách làm và tìm cách triển khai hiệu quả trong công việc hằng ngày.' },
] as const;
---
<Base title="Chuyên môn" description="Giảng dạy AI ứng dụng: AI Automation, AI cơ bản, AI cho kế toán, AI cho người làm văn phòng." hero>
  <section class="hero" data-scene>
    <div class="ghost" aria-hidden="true" data-depth="-0.5">AI</div>
    <div class="wrap hero-in">
      <p class="eyebrow reveal" style="--d:0">{`Đỗ Trường Sơn / Chuyên môn`}</p>
      <h1 class="reveal" style="--d:1">Hiểu AI.<br />Ứng dụng vào công việc.</h1>
      <p class="lead reveal" style="--d:2">Tôi giảng dạy AI ứng dụng cho người đi làm, với các tình huống gần với công việc hằng ngày.</p>
    </div>
  </section>

  <section class="section topics">
    <div class="wrap">
      {courseGroups.map((g) => (
        <div class="grp">
          <div class="ghead reveal"><h2>{g.title}</h2><p class="muted">{g.desc}</p></div>
          <div class="tgrid">
            {topics.filter((c) => c.group === g.id).map((c, i) => (
              <a class="topic reveal" style={`--d:${i % 2}`} href={`${base}/chuyen-mon/${c.slug}/`}>
                <Scene kind={c.art} thumb depths={[0, 0, 0]} />
                <div class="tbody">
                  <div class="thead"><span class="tn">{String(++k).padStart(2, '0')}</span><Icon name={icons[c.slug as keyof typeof icons] ?? 'doc'} /></div>
                  <h3>{c.title}</h3>
                  <p>{c.summary}</p>
                  <span class="link-arrow go">Tìm hiểu</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
      <div class="grp other reveal">
        <div class="ghead"><h2>Các nhóm lớp khác đã hướng dẫn</h2><p class="muted">Nội dung điều chỉnh theo công việc và nhu cầu người học.</p></div>
        <ul>{otherClasses.map((x) => <li>{x}</li>)}</ul>
      </div>
      <p class="muted note">Đây là giới thiệu các lĩnh vực tôi đang giảng dạy, chưa phải thông báo tuyển sinh; học phí và lịch học được trao đổi trực tiếp.</p>
    </div>
  </section>

  <section class="section dark how">
    <div class="wrap">
      <div class="head-row reveal"><div><p class="eyebrow">Cách làm việc</p><h2>Cách tôi hướng dẫn thực hành</h2></div></div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="reveal" style={`--d:${i}`}>
            <span class="sico"><Icon name={s.icon} size={24} /></span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section dark closing">
    <div class="wrap contact reveal">
      <div><h2>Trao đổi về chủ đề bạn quan tâm.</h2><p class="muted">Gửi tôi tên chủ đề qua Zalo. Trang web không có biểu mẫu thu thập thông tin liên hệ.</p></div>
      <div class="cta-row"><ZaloButton label="Liên hệ qua Zalo" variant="accent" source="topics-contact" /></div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding: 112px 0 56px;
    background: radial-gradient(700px 280px at 74% 30%, rgba(255,255,255,.95), transparent 70%), linear-gradient(180deg, #b9d2f6 0%, #d6e5fa 55%, var(--bg) 100%); }
  .ghost { position: absolute; right: 6%; top: 36px; z-index: 0; font: 700 clamp(160px, 26vw, 360px)/.9 var(--display); color: rgba(255,255,255,.96); pointer-events: none; user-select: none;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%); mask-image: linear-gradient(180deg, #000 55%, transparent 100%); }
  .hero-in { position: relative; z-index: 1; }
  .lead { font-size: 15.5px; color: #2f3b54; max-width: 52ch; margin: 0; }
  .topics { padding-top: 20px; }
  .tgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .topic { display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; text-decoration: none; transition: border-color .18s ease, box-shadow .18s ease; }
  .topic:hover { border-color: var(--ink); box-shadow: 0 10px 28px rgba(11,20,36,.09); }
  .topic :global(.scene.thumb) { aspect-ratio: 16 / 8; }
  .tbody { padding: 16px 20px 20px; display: grid; gap: 6px; }
  .thead { display: flex; align-items: center; justify-content: space-between; color: var(--muted); }
  .tn { font: 700 22px var(--display); letter-spacing: .04em; }
  .tbody h3 { margin: 0; font-size: 19px; }
  .grp { margin-top: 30px; }
  .grp:first-child { margin-top: 0; }
  .ghead { margin-bottom: 14px; }
  .ghead h2 { margin: 0 0 4px; font-size: 22px; }
  .ghead p { margin: 0; font-size: 14.5px; }
  .other ul { margin: 0; padding-left: 20px; display: grid; gap: 4px; }
  .tbody p { margin: 0; color: var(--muted); font-size: 14.5px; }
  .go { justify-self: start; margin-top: 6px; }
  .note { font-size: 13.5px; margin-top: 16px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .steps li { border-top: 1px solid var(--navy-line); padding-top: 18px; }
  .sico { display: inline-grid; place-items: center; width: 44px; height: 44px; border: 1px solid #3a4c70; border-radius: 12px; margin-bottom: 12px; color: var(--on-dark); }
  .steps h3 { margin: 0 0 6px; font-size: 17px; }
  .steps p { margin: 0; color: var(--on-dark-muted); font-size: 14.5px; }
  .closing { border-top: 1px solid var(--navy-line); }
  .contact { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .contact h2 { margin-bottom: 6px; }
  @media (max-width: 860px) {
    .tgrid, .steps { grid-template-columns: 1fr; }
    .hero { padding: 120px 0 40px; }
    .ghost { right: 2%; font-size: clamp(130px, 40vw, 220px); }
  }
</style>
