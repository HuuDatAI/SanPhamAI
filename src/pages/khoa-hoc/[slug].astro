---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import ZaloButton from '../../components/ZaloButton.astro';
import CopyLink from '../../components/CopyLink.astro';
import { getCourses, getCourse, priceLabel } from '../../lib/store';

export function getStaticPaths() {
  return getCourses().map((c) => ({ params: { slug: c.slug } }));
}
const c = getCourse(Astro.params.slug!)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={c.title} description={c.summary}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Điều hướng phụ"><a href={`${base}/khoa-hoc/`}>← Quay lại danh sách khóa học</a></nav>
    <article class="detail">
      <header>
        <h1>{c.title}</h1>
        <p class="lead">{c.summary}</p>
      </header>
      <div class="cover"><Art kind={c.art} note={false} /></div>
      <dl class="facts">
        <div><dt>Học phí</dt><dd>{priceLabel(c)}</dd></div>
        <div><dt>Lịch học</dt><dd>{c.scheduleText}</dd></div>
        {c.format && <div><dt>Hình thức</dt><dd>{c.format}</dd></div>}
      </dl>
      {c.audience.length > 0 && <section><h2>Đối tượng phù hợp</h2><ul>{c.audience.map((a) => <li>{a}</li>)}</ul></section>}
      <section><h2>Nội dung</h2><ul>{c.syllabus.map((s) => <li>{s}</li>)}</ul></section>
      <p class="muted small">Trang này giới thiệu lĩnh vực đang giảng dạy, chưa phải thông báo tuyển sinh hay cam kết về lịch khai giảng, thời lượng hoặc kết quả đầu ra.</p>
      <aside class="ask">
        <h2>Quan tâm chương trình này?</h2>
        <div class="cta-row">
          <ZaloButton label="Tư vấn chương trình đào tạo" source="course" entity={c.id} />
          <CopyLink title={c.title} />
        </div>
      </aside>
    </article>
  </div>
</Base>

<style>
  .detail { max-width: 820px; padding-bottom: 24px; }
  .lead { font-size: 18px; color: var(--muted); }
  .cover { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; margin: 20px 0 24px; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0; margin: 0 0 28px; border-top: 1px solid var(--line); }
  .facts div { padding: 14px 0; border-bottom: 1px solid var(--line); }
  dt { font-size: 13px; color: var(--muted); } dd { margin: 2px 0 0; font-weight: 500; }
  section { margin: 24px 0; } .small { font-size: 14px; }
  .ask { margin-top: 36px; padding: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--soft); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 14px; }
</style>
