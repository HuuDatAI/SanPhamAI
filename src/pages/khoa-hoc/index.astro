---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import { getCourses, priceLabel } from '../../lib/store';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const courses = getCourses();
---
<Base title="Khóa học" description="Các hướng đào tạo AI ứng dụng: AI Automation, AI cơ bản, AI cho kế toán, AI cho dân văn phòng.">
  <div class="wrap">
    <h1 class="pg-title">Khóa học</h1>
    <p class="muted intro">Đây là các hướng tôi đang giảng dạy. Học phí và lịch học được trao đổi trực tiếp qua Zalo.</p>
    <div class="grid">
      {courses.map((c) => (
        <a class="card reveal" href={`${base}/khoa-hoc/${c.slug}/`}>
          <Art kind={c.art} note={false} />
          <div class="body">
            <h3>{c.title}</h3>
            <p>{c.summary}</p>
            <div class="tags"><span class="tag">Học phí: {priceLabel(c)}</span><span class="tag">{c.scheduleText}</span></div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
<style>.pg-title { margin: 20px 0 8px; } .intro { max-width: 60ch; margin-bottom: 16px; }</style>
