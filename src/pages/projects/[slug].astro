---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import ZaloButton from '../../components/ZaloButton.astro';
import CopyLink from '../../components/CopyLink.astro';
import { getProjects, getProject, getIndustries, getSolutions, nameOf, safeUrl } from '../../lib/store';

export function getStaticPaths() {
  return getProjects().map((p) => ({ params: { slug: p.slug } }));
}
const p = getProject(Astro.params.slug!)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const inds = p.industryIds.map((i) => nameOf(getIndustries(), i));
const sols = p.solutionIds.map((i) => nameOf(getSolutions(), i));
const demo = safeUrl(p.demoUrl);
const missing = !p.problem && p.features.length === 0 && p.technologies.length === 0;
---
<Base title={p.title} description={p.summary}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Điều hướng phụ"><a href={`${base}/projects/`}>← Quay lại danh sách dự án</a></nav>
    <article class="detail">
      <header>
        {p.isSample && <span class="badge-sample">Minh họa</span>}
        <h1>{p.title}</h1>
        <p class="lead">{p.summary}</p>
        <div class="tags">{[...inds, ...sols].map((n) => <span class="tag">{n}</span>)}</div>
      </header>

      <div class="cover"><Art kind={p.art} /></div>

      {p.problem && <section><h2>Bài toán cần giải quyết</h2><p>{p.problem}</p></section>}
      {p.features.length > 0 && <section><h2>Tính năng</h2><ul>{p.features.map((f) => <li>{f}</li>)}</ul></section>}
      {p.technologies.length > 0 && <section><h2>Công nghệ</h2><div class="tags">{p.technologies.map((t) => <span class="tag">{t}</span>)}</div></section>}
      {missing && <p class="state">Thông tin chi tiết, hình ảnh thật và demo của dự án này đang được bổ sung.</p>}
      {demo && <p><a class="btn line" href={demo} target="_blank" rel="noopener noreferrer">Dùng thử</a></p>}

      <aside class="ask">
        <h2>Cần giải pháp tương tự?</h2>
        <p class="muted">Gửi tên dự án qua Zalo để trao đổi. Bạn có thể sao chép tên và đường dẫn dưới đây để gửi kèm.</p>
        <div class="cta-row">
          <ZaloButton label="Tư vấn làm dự án tương tự" source="project" entity={p.id} />
          <CopyLink title={p.title} />
        </div>
      </aside>
    </article>
  </div>
</Base>

<style>
  .detail { max-width: 820px; padding-bottom: 24px; }
  .detail header { margin: 8px 0 22px; }
  .lead { font-size: 16px; color: var(--muted); }
  .cover { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; margin-bottom: 28px; }
  section { margin: 28px 0; }
  .ask { margin-top: 40px; padding: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--soft); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 14px; }
</style>
